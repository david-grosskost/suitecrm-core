{
    "name": "david-grosskost/suitecrm-core",
    "description": "Base of the SuiteCRM projects: SuiteCRM 8 image with the French base configuration.",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/david-grosskost/suitecrm-devkit",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/david-grosskost/suitecrm-ext-upstream-fixes",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/david-grosskost/suitecrm-ext-french-company-fields",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/david-grosskost/suitecrm-ext-french-company-validation",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/david-grosskost/suitecrm-ext-opportunity-reminders",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/david-grosskost/suitecrm-ext-front-customizer",
            "no-api": true
        }
    ],
    "require": {
        "composer/semver": "^3.4",
        "david-grosskost/suitecrm-ext-french-company-fields": "^0.2",
        "david-grosskost/suitecrm-ext-french-company-validation": "^0.1",
        "david-grosskost/suitecrm-ext-front-customizer": "^0.1",
        "david-grosskost/suitecrm-ext-opportunity-reminders": "^0.1",
        "david-grosskost/suitecrm-ext-upstream-fixes": "^0.2",
        "fakerphp/faker": "^1.24"
    },
    "require-dev": {
        "david-grosskost/suitecrm-devkit": "^0.21"
    },
    "config": {
        "platform": {
            "php": "8.4.27"
        },
        "preferred-install": {
            "david-grosskost/*": "source"
        },
        "sort-packages": true
    }
}
