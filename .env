# Project identity, shared by every environment
APP_SLUG=suitecrm-core
DB_NAME=suitecrm
DB_USER=suitecrm

# Image published on GHCR by the release workflow, run on the servers
APP_IMAGE=ghcr.io/david-grosskost/suitecrm-core

# Extensions run by every instance (slugs separated by commas, among those
# composer.json requires). A client project lists its own.
EXTENSIONS=
