# Static analysis of this project (make quality@stan).
# Shared settings come from suitecrm-devkit; errors already known are listed
# in phpstan-baseline.neon (make quality@baseline).
includes:
    - vendor/david-grosskost/suitecrm-devkit/config/phpstan.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - config
        - scripts
        - database
    tmpDir: .tools/phpstan
    # SuiteCRM classes exist only inside the image: their signatures are here.
    scanFiles:
        - stubs/suitecrm.stub
    ignoreErrors:
        # These scripts run inside the image, after chdir() into SuiteCRM.
        -
            identifier: requireOnce.fileNotFound
            path: scripts/post-install.php
        -
            identifier: requireOnce.fileNotFound
            path: database/seeders/seed.php
