# Copy to .env.local (never committed) and fill in.
# make app@install does it, and generates the change-me passwords.

# Environment: local, demo or prod
APP_ENV=local
APP_HOST=suitecrm-core.dev.localhost

DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

# SuiteCRM administrator, created at install
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
