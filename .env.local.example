# Copy to .env.local (never committed) and fill in.
# make app@install does it, and generates the change-me passwords (on a server,
# each deployment generates those still missing).

# Environment: local, demo or prod
APP_ENV=local
APP_HOST=suitecrm-core.dev.localhost

# Servers only (demo, prod): version of the image to run, written by each
# deployment. On a server, also set APP_SLUG to a name unique on the machine
# (e.g. demo-core): it overrides the one of .env.
APP_VERSION=

DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

# SuiteCRM administrator, created at install
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Demo only: password of the Mailpit inbox (https://mail-<APP_HOST>), unique
# per instance, generated by the deployment like the others. User: demo
# (MAILPIT_USER to change it).
MAILPIT_PASSWORD=change-me
