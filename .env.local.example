# Copy to .env.local (never committed) and fill in.
# make app@install does it, and generates the change-me passwords.

# Environment: local, demo or prod
APP_ENV=local
APP_HOST=suitecrm-core.dev.localhost

# Servers only (demo, prod): version of the image to run, written by each
# deployment. On a server, also set APP_SLUG to a name unique on the machine
# (e.g. demo-core): it overrides the one of .env.
APP_VERSION=

DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

# SuiteCRM administrator, created at install
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
